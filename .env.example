APP_ORIGIN=http://localhost:8080
DATABASE_PATH=data/copier.db
SETUP_TOKEN=
# App credentials from https://openapi.ctrader.com
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# true permits confirmed trading commands once copying is enabled in the UI.
# false disables ALL trading commands, including management of existing copied positions.
ENGINE_TRADING_ENABLED=true
